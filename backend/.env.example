PORT=8080

# MongoDB Connection String (Atlas or Local)
# Option A (MongoDB Atlas): mongodb+srv://<user>:<password>@cluster0.mongodb.net/pollnow?retryWrites=true&w=majority
# Option B (Local MongoDB): mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=pollnow

# Redis Connection String (Upstash or Local)
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# JWT Token Secret
JWT_SECRET=pollnow_jwt_secret_key_2026

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:5173

# Frontend URL
FRONTEND_URL=http://localhost:5173
ENV=development
